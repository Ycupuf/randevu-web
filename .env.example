# Bu dosyayı .env.local olarak kopyala ve değerleri doldur. .env.local ASLA commit edilmez.
# Değerler Supabase panelinde: Project Settings > API

# Herkese açık (tarayıcıda görünür), RLS ile korunur
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...), Supabase panelinde Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sitenin kendi adresi (yerelde http://localhost:3000, canlıda Vercel adresi); sihirli bağlantı yönlendirmesi için
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GİZLİ: yalnızca sunucuda ve testlerde kullanılır. Tarayıcıya ya da depoya girmemeli.
# (Playwright testi için kullanıcı oluşturur; uygulama kodu bunu kullanmaz.)
SUPABASE_SERVICE_ROLE_KEY=
